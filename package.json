{
  "name": "stay-in-touch",
  "private": true,
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "scripts": {
    "mobile": "pnpm --filter @stay-in-touch/mobile start",
    "api:dev": "pnpm --filter @stay-in-touch/api dev",
    "api:deploy": "pnpm --filter @stay-in-touch/api run deploy",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "dependencies": {
    "@neon/config": "^1.1.0",
    "@neon/env": "^1.1.6"
  }
}
